# Staging backend config. Committed — contains no secrets (public API Gateway
# URL + Cognito public client id/domain, all shipped in the browser bundle).
# Loaded by: npm run build:staging / npm run start:staging  (vite --mode staging)
#
# TODO: replace the placeholder values below with the staging TF outputs.

REACT_APP_USE_MOCKS=false

# Backend API base. The app calls this host directly with absolute URLs
# (${API_URL}/api/v1/...), and chat derives from it (${API_URL}/api/v1/chat) —
# so API Gateway must send CORS headers for the S3/CloudFront origin.
REACT_APP_API_URL=https://replace-with-staging-api-id.execute-api.us-west-2.amazonaws.com

# OAuth — Cognito hosted UI. domain + clientId come straight from the TF outputs.
REACT_APP_OAUTH_PROVIDERS=[{"id":"aws","type":"cognito","displayName":"IDP","domain":"replace-with-staging-domain.auth.us-west-2.amazoncognito.com","clientId":"replace-with-staging-client-id","icon":"cloud"}]
